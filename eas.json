{
  "cli": {
    "version": ">= 11.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": false
    },
    "internal": {
      "extends": "base",
      "distribution": "internal",
      "channel": "internal",
      "autoIncrement": false
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true
    },
    "development": {
      "extends": "base",
      "developmentClient": false,
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "serviceAccountKeyPath": "./google-play-service-account.json"
      }
    }
  }
}
